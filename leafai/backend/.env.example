# LeafAI Backend — Environment Variables
# Copy this file to .env and keep your key private.

# Optional hosted chatbot answers. The local plant library remains available
# when Groq is not configured or cannot be reached.
GROQ_API_KEY=
# Optional model override; defaults to openai/gpt-oss-120b.
# Choose a model currently available to your Groq account.
GROQ_MODEL=openai/gpt-oss-120b
